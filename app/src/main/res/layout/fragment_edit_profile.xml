<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.profile.EditProfileFragment">

    <TextView
        android:layout_marginTop="30dp"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Edit Profile"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/status_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/status_bar_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/image_avatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/img_user"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Edit icon overlay -->
            <Button
                android:id="@+id/btn_change_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_edit_profile"
                android:drawableTint="@color/icon_primary"
                android:background="@drawable/bg_circle_white"
                android:padding="6dp"
                app:layout_constraintBottom_toBottomOf="@id/image_avatar"
                app:layout_constraintEnd_toEndOf="@id/image_avatar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Display Name"
                android:id="@+id/tv_displayName"
                app:layout_constraintTop_toBottomOf="@id/image_avatar"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_margin="20dp"
                />
            <!-- Display Name Input -->
            <EditText
                android:id="@+id/edt_display_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginHorizontal="24dp"
                android:hint="Your display name"
                android:textSize="16sp"
                android:padding="15dp"
                android:background="@drawable/bg_edt"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tv_displayName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bio"
                android:id="@+id/tv_bio"
                app:layout_constraintTop_toBottomOf="@id/edt_display_name"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_margin="20dp"
                />
            <EditText
                android:id="@+id/edt_bio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginHorizontal="24dp"
                android:hint="Your bio"
                android:textSize="16sp"
                android:padding="15dp"
                android:background="@drawable/bg_edt"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tv_bio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:id="@+id/tv_email"
                app:layout_constraintTop_toBottomOf="@id/edt_bio"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_margin="20dp"
                />
            <EditText
                android:id="@+id/edt_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginHorizontal="24dp"
                android:hint="Your email"
                android:textSize="16sp"
                android:padding="15dp"
                android:background="@drawable/bg_edt"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tv_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:id="@+id/tv_phonenumber"
                app:layout_constraintTop_toBottomOf="@id/edt_email"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:layout_margin="20dp"
                />
            <EditText
                android:id="@+id/edt_phonenumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginHorizontal="24dp"
                android:hint="Your email"
                android:textSize="16sp"
                android:padding="15dp"
                android:background="@drawable/bg_edt"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tv_phonenumber"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/image_avatar"
                app:layout_constraintStart_toStartOf="@id/image_avatar"
                app:layout_constraintEnd_toEndOf="@id/image_avatar"
                app:layout_constraintBottom_toBottomOf="@id/image_avatar"
                android:id="@+id/progress_bar"
                android:visibility="gone"
                />
            <!-- Save Button -->
            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Save changes"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_button_primary"
                android:textColor="@color/text_white"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/edt_phonenumber"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/bg_button_disable"
                android:textColor="@color/error"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/btn_save"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="10dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>